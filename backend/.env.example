# Copie este arquivo para ".env" e preencha. O ".env" NUNCA vai para o Git.

AMBIENTE=local
TIMEZONE=America/Sao_Paulo

# Banco PostgreSQL local (o docker-compose.yml sobe um com estes dados)
DATABASE_URL=postgresql+psycopg://libreleitura:libreleitura@localhost:5432/libreleitura

# Segredos da aplicação. Gere valores novos com:  python -m app.cli gerar-chaves
JWT_SECRET=
CHAVE_FERNET=
CHAVE_HMAC=

# Em http://localhost o cookie não pode ser "Secure" (em produção deixe true)
COOKIE_SECURE=false

# Origens liberadas para o frontend em desenvolvimento (formato JSON)
CORS_ORIGINS=["http://localhost:5173"]
