# Configuração do ambiente Elastic Beanstalk (plataforma Python 3.12 / Amazon Linux 2023).
# Valores específicos de cada ambiente (AWS_SECRET_APP_ID, AWS_SECRET_DB_ID, DB_HOST)
# são definidos no console do EB ou com "eb setenv", e não neste arquivo.

option_settings:
  # Variáveis de ambiente comuns a todos os ambientes
  aws:elasticbeanstalk:application:environment:
    AMBIENTE: prod
    TIMEZONE: America/Sao_Paulo
    AWS_REGION: sa-east-1
    COOKIE_SECURE: "true"

  # Health check do ALB aponta para a rota que testa a conexão com o banco
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health
    MatcherHTTPCode: "200"

  # Deploy sem tirar o sistema do ar: atualiza uma instância por vez
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Fixed
    BatchSize: 1

container_commands:
  # Migrações rodam uma única vez por deploy (só na instância líder)
  01_migrar_banco:
    command: "bash scripts/migrar.sh"
    leader_only: true
